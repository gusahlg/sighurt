#!/usr/bin/env bash
# Runs a heavy command (a build, a benchmark, a GPU job) on this machine, the safe way:
#
# - one heavy job per machine at a time: /tmp/gusahlg-heavy.lock is shared with the other Claude
#   session working on this user's machines (tensor-ash), which takes it for all of its builds,
#   benchmarks and GPU jobs too. Always take it before any other lock. While we hold it,
#   /tmp/gusahlg-heavy.owner says what is running, for the other session to read;
# - memory-capped (SIG_MEM, default 9G), so a Servo link can't take the machine down;
# - inside the repo's nix-shell, which NixOS needs for the native libraries.
#
#   tools/heavy cargo build -p sighurt-core
#   SIG_WHAT="servo build" tools/heavy cargo build -p sighurt-engine-servo
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
host=$(hostname)
lock=/tmp/gusahlg-heavy.lock
owner=/tmp/gusahlg-heavy.owner
if [[ -z ${SIG_HEAVY_HELD:-} ]]; then
  if ! flock -n "$lock" true 2>/dev/null; then
    echo "tools/heavy: waiting for $lock ($(cat "$owner" 2>/dev/null || echo 'held by another session'))" >&2
  fi
  SIG_HEAVY_HELD=1 exec flock -E 75 "$lock" "$0" "$@"
fi
echo "sighurt: ${SIG_WHAT:-$*} (since $(date +%H:%M), pid $$)" > "$owner"
trap 'rm -f "$owner"' EXIT
jobs=${SIG_JOBS:-8} mem=${SIG_MEM:-9G}
props=()
# While /tmp/gusahlg-desktop-embargo exists, the user is using this desktop (gaming, say):
# jobs run at idle CPU and IO priority with 2 cores and 6G, Servo is built on louise-pc
# instead, and nothing started here may reach the user's live Wayland session.
if [[ $host != louise && -e /tmp/gusahlg-desktop-embargo ]]; then
  echo "tools/heavy: the user is using this desktop right now: running at idle priority with 2 jobs." \
    "The live desktop (wayland-1) is off-limits; use tools/headless-sway, or louise-pc via tools/remote." >&2
  if [[ " ${SIG_WHAT:-} $* " == *servo* ]]; then
    echo "tools/heavy: refusing a Servo job on this desktop while the user is using it;" \
      "run it on louise-pc: tools/remote $*" >&2
    exit 75
  fi
  jobs=2 mem=6G
  props=(-p CPUWeight=idle -p IOWeight=1 --nice=19)
  [[ ${XDG_RUNTIME_DIR:-} == /tmp/sighl.* ]] || unset WAYLAND_DISPLAY DISPLAY
fi
export CARGO_BUILD_JOBS=$jobs
quoted=$(printf '%q ' "$@")
systemd-run --user --scope --quiet --collect -p MemoryMax="$mem" -p MemorySwapMax=0 "${props[@]}" \
  nix-shell "$repo/shell.nix" --run "cd $(printf '%q' "$PWD") && $quoted"
