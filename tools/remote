#!/usr/bin/env bash
# Runs a command in a copy of this working tree on louise-pc (12 cores, 15 GB RAM, RTX 4060, lots of
# disk), under that machine's heavy-job locks. The tree is synced first (without target/ and .git);
# louise keeps its own target/ in ~/repos/sighurt-rewrite, so Servo stays built there.
#
#   tools/remote tools/cargo build -p sighurt-browser
#   tools/remote tools/heavy bench/run.sh servo-static
#   tools/remote --no-sync ls target/debug
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
# SIG_REMOTE_DEST picks another copy on louise (its own target/), e.g. for a worktree that must
# not share Servo's build with this tree.
dest=${SIG_REMOTE_DEST:-repos/sighurt-rewrite}
sync=1
[[ ${1:-} == --no-sync ]] && { sync=0; shift; }
# While the user is using louise-pc (gaming), nothing heavy runs there: say so before syncing.
if ssh -o BatchMode=yes -o ConnectTimeout=8 louise-pc \
    '[ -e /tmp/gusahlg-desktop-embargo ] || pgrep -f "steamapps/commo[n]/" >/dev/null' 2>/dev/null; then
  echo "tools/remote: the user is using louise-pc right now (gaming): run this on the desktop" \
    "instead (the same command without tools/remote)." >&2
  exit 75
fi
# One remote run at a time from this machine, so a sync never changes the tree under a build.
exec 9>"/tmp/sighurt-remote${SIG_REMOTE_DEST:+-${SIG_REMOTE_DEST//\//-}}.lock"
if ! flock -n 9; then
  echo "tools/remote: waiting for another remote run from this machine" >&2
  flock 9
fi
if [[ $sync == 1 ]]; then
  rsync -a --delete --exclude /target --exclude /.git --exclude '/bench/results/raw' \
    -e 'ssh -o BatchMode=yes' "$repo/" "louise-pc:$dest/"
fi
# The remote login shell is fish, so the command goes to bash on stdin rather than through
# ssh's command line.
{
  echo "set -e; cd ~/$dest"
  for var in SIG_MEM SIG_JOBS SIG_WHAT RUST_LOG RUST_BACKTRACE; do
    [[ -n ${!var:-} ]] && echo "export $var=$(printf '%q' "${!var}")"
  done
  printf 'exec'; printf ' %q' "$@"; echo
} | ssh -o BatchMode=yes louise-pc bash -s
